        method: POST
        body:
          mimeType: application/graphql
          text: '{"query":"mutation execute {\n  startJob(\n    fileId:
            \"881189d3-59b8-48d7-84fe-3199bdfbc40a\",\n    #Device IDs OR Tags
            are used to identify the devices for the job. If both device IDs and

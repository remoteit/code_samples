      - url: "{{ _.base_url }}"
        name: "Query: Get Events For Specific Device"
        meta:
          id: req_d70cb01ecd044a918811b8efd028ab98
          created: 1652112201478
          modified: 1652243276984
          isPrivate: false
          sortKey: -1640281812682.728
        method: POST
        body:
          mimeType: application/graphql
          text: '{"query":"#This query returns logs for a given list of devices and a list
            of device events\n#How far logs can be retrieved is determined by
            your subscription level\n\nquery getEvents(\n\t$deviceID:
